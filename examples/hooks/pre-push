#!/usr/bin/env bash
# gh-stats Shift-Left Pre-Push Git Hook Example
#
# Prevents pushing commits that exceed configured SRE risk thresholds
# (e.g. missing tests, high blast radius changes to sensitive files).
#
# Installation:
#   1. Using the gh-stats CLI (recommended):
#      gh-stats hook install --type=pre-push
#
#   2. Manual:
#      cp examples/hooks/pre-push .git/hooks/pre-push
#      chmod +x .git/hooks/pre-push

set -euo pipefail

# Allow bypassing via environment variable or standard git flags (--no-verify)
if [ "${SKIP_GH_STATS:-0}" = "1" ]; then
    echo "⚡ gh-stats pre-push hook skipped (SKIP_GH_STATS=1)"
    exit 0
fi

# Locate gh-stats executable
if command -v gh-stats >/dev/null 2>&1; then
    CMD=(gh-stats)
elif command -v go >/dev/null 2>&1 && [ -f "cmd/gh-stats/main.go" ]; then
    CMD=(go run ./cmd/gh-stats)
else
    echo "⚠️  gh-stats not found in PATH. Skipping pre-push risk evaluation."
    echo "   To install: brew install smford/tap/gh-stats OR go install github.com/smford/gh-stats/cmd/gh-stats@latest"
    exit 0
fi

# Execute pre-push risk assessment
exec "${CMD[@]}" hook run --type=pre-push
